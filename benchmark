#!/usr/bin/env bash
set -Eeuo pipefail
ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
source "$ROOT/lib/common.sh"
export PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}"

run_module() {
 require_command python3
 exec python3 -m "$@"
}

case "${1:-}" in
 --legacy-phase1)
  shift
  exec bash "$ROOT/lib/legacy-launcher.sh" "$@"
  ;;
 --validate|--validation-profile|--validation-report-only|--check-deps)
  exec bash "$ROOT/lib/legacy-launcher.sh" "$@"
  ;;
 --report-only|--development-report)
  shift
  run_module lbt_g5.workload_report "$@"
  ;;
 --menu|--development-menu)
  shift
  run_module lbt_g5.workload_menu "$@"
  ;;
 --development-workloads)
  shift
  run_module lbt_g5.workload_cli "$@"
  ;;
 --help|-h)
  cat <<'HELP'
Linux Benchmark Toolkit
Usage:
  ./benchmark                               Open Dialog in a terminal
  ./benchmark --mode discovery|standard|extended|interactive [--results-dir DIR] [OPTIONS]
  ./benchmark --menu [--results-dir DIR]
  ./benchmark --report-only SESSION_DIR
  ./benchmark --report-only --latest-under RESULTS_DIR
  ./benchmark --list-tests
  ./benchmark --check-deps
  ./benchmark --validate [--validation-profile quick|standard|full]
  ./benchmark --validation-report-only SESSION_DIR
Modes: discovery, standard, extended, interactive.
Use ./benchmark --mode MODE --help for workload and device options.
HELP
  exit 0
  ;;
esac

if (($# == 0)) && [[ -t 0 && -t 2 ]]; then
 run_module lbt_g5.workload_menu
fi
run_module lbt_g5.workload_cli --publish "$@"
